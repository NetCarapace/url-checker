[flake8]
select =
    B,
    C,
    E,
    F,
    W,
    T4,
    B9
# compatibility with Black
#select =
#    E9,
#    F63,
#    F7,
#    F82
ignore =
    B950,
    E203,
    E266,
    E501,
    W503,
    F403,
    F401
max-line-length = 88
##
max-complexity = 18
extend_exclude =
    *.egg-info,
    *.html,
    *.txt,
    src/url_checker/migrations/*,
    venv,
    templates
